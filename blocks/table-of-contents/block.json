{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "my-custom-plugin/table-of-contents",
  "version": "1.0.0",
  "title": "Table of Contents (In This Guide)",
  "category": "text",
  "icon": "list-view",
  "description": "Auto-generates a multi-column Table of Contents from your post headings with show/hide controls and custom link styling.",
  "keywords": ["toc", "table of contents", "guide", "headings", "links", "outline"],
  "textdomain": "my-custom-plugin",
  "supports": {
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "example": {
    "attributes": {
      "title": "📋 In This Guide",
      "columns": 2,
      "linkColor": "#7c3aed",
      "customLinks": [
        { "text": "1. Quick Comparison Table", "url": "#" },
        { "text": "2. Evaluation & Testing Criteria", "url": "#" },
        { "text": "3. Top Recommended Picks", "url": "#" },
        { "text": "4. Buyer's Guide & Limitations", "url": "#" }
      ]
    },
    "viewportWidth": 600
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "📋 In This Guide"
    },
    "columns": {
      "type": "number",
      "default": 2
    },
    "linkColor": {
      "type": "string",
      "default": "#7c3aed"
    },
    "includeH2": {
      "type": "boolean",
      "default": true
    },
    "includeH3": {
      "type": "boolean",
      "default": true
    },
    "includeH4": {
      "type": "boolean",
      "default": false
    },
    "hiddenHeadings": {
      "type": "array",
      "default": []
    },
    "headings": {
      "type": "array",
      "default": []
    },
    "customLabels": {
      "type": "object",
      "default": {}
    },
    "customLinks": {
      "type": "array",
      "default": []
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
